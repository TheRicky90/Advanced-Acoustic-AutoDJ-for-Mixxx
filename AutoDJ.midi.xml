<?xml version="1.0" encoding="UTF-8"?>
<MixxxControllerPreset mixxxVersion="2.5.0+" schemaVersion="1">
    <info>
        <n>AutoDJ LoopMIDI - Optimized VU/UV</n>
        <author>Fixed AutoDJ Implementation</author>
        <description>Advanced AutoDJ with proper MIDI mapping, script binding, and controller integration</description>
    </info>

    <settings>
        <group label="Sincronizzazione BPM">
            <row orientation="vertical">
                <option
                    variable="bpmSyncFade"
                    type="boolean"
                    default="true"
                    label="Attiva il matching automatico del BPM durante il fade">
                    <description>
                        Se attivo, durante ogni transizione i due deck convergono gradualmente verso un BPM comune (meeting point), agganciato in tempo reale alla posizione del crossfader. Se disattivato, i BPM delle tracce non vengono toccati.
                    </description>
                </option>
                <option
                    variable="beatPhaseSync"
                    type="boolean"
                    default="true"
                    label="Attiva l'allineamento di fase (downbeat sync)">
                    <description>
                        Se attivo, oltre al BPM viene corretta anche la posizione dei battiti (beat_distance) tra i due deck con micro salti impercettibili, per un sync reale e non solo di tempo. Richiede bpmSyncFade attivo.
                    </description>
                </option>
                <option
                    variable="maxBpmAdjustment"
                    type="integer"
                    min="0"
                    max="100"
                    default="20"
                    label="Divario massimo di BPM tollerato (%)">
                    <description>
                        Se la differenza percentuale di BPM tra le due tracce (considerando anche mezzo/doppio tempo) supera questa soglia, la traccia in coda viene saltata invece di essere mixata.
                    </description>
                </option>
            </row>
        </group>
        <group label="Filtri ed effetti">
            <row orientation="vertical">
                <option
                    variable="filterFxIntensity"
                    type="real"
                    precision="2"
                    min="0.0"
                    max="1.0"
                    step="0.05"
                    default="0.85"
                    label="Intensità del filtro Moog nel passaggio">
                    <description>
                        Quanto si chiude il filtro passa-basso sulle due tracce durante la transizione. 1.0 = massima intensità, 0.0 = filtro disattivato.
                    </description>
                </option>
                <option
                    variable="filterFxInvert"
                    type="boolean"
                    default="false"
                    label="Inverti la direzione del filtro">
                    <description>
                        Se attivo, inverte il verso di apertura/chiusura del filtro Moog sui due deck durante il fade.
                    </description>
                </option>
                <option
                    variable="echoIntensitySolo"
                    type="real"
                    precision="2"
                    min="0.0"
                    max="1.0"
                    step="0.05"
                    default="0.35"
                    label="Intensità dell'eco quando una traccia suona da sola">
                    <description>
                        Livello del drywet dell'echo (proporzionale al VU meter) applicato quando un solo deck sta suonando, fuori dalle transizioni.
                    </description>
                </option>
                <option
                    variable="transpose"
                    type="boolean"
                    default="true"
                    label="Trasponi automaticamente la tonalità della traccia in entrata">
                    <description>
                        Se attivo, prova ad allineare armonicamente la tonalità della traccia in coda a quella in uscita usando sync_key.
                    </description>
                </option>
                <option
                    variable="transposeMax"
                    type="real"
                    precision="2"
                    min="0.0"
                    max="12.0"
                    step="0.5"
                    default="1.0"
                    label="Massimo scarto di tonalità tollerato (semitoni)">
                    <description>
                        Se la trasposizione richiesta supera questo valore, la traccia viene saltata (fino al numero massimo di salti consecutivi) invece di essere stonata forzatamente.
                    </description>
                </option>
            </row>
        </group>
        <group label="Timing e cue">
            <row orientation="vertical">
                <option
                    variable="exitCue"
                    type="integer"
                    min="1"
                    max="8"
                    default="4"
                    label="Numero dell'hotcue usato come trigger di uscita">
                    <description>
                        L'hotcue sulla traccia in uscita che segnala allo script il punto in cui avviare la transizione.
                    </description>
                </option>
                <option
                    variable="preStart"
                    type="integer"
                    min="0"
                    max="256"
                    default="64"
                    label="Beat di pre-roll prima dell'hotcue di uscita">
                    <description>
                        Quanti beat prima del cue point la traccia in entrata viene posizionata, per dare tempo alla transizione di svilupparsi.
                    </description>
                </option>
            </row>
        </group>
    </settings>
    
    <controller id="loopMIDI Port">
        <!-- Script file configuration -->
        <scriptfiles>
            <!-- functionprefix must match the object name in JS (midiAutoDJ) -->
            <file functionprefix="midiAutoDJ" filename="AutoDJ.js"/>
        </scriptfiles>
        
        <controls>
            <!-- ==================== PLAY INDICATORS - CRITICAL FOR TRANSITION DETECTION ==================== -->
            
            <!-- Channel 1 Play Indicator - Maps to [Channel1],play_indicator Mixxx Control -->
            <control id="[Channel1],play_indicator">
                <group>[Channel1]</group>
                <key>play_indicator</key>
                <status>0x91</status>
                <midino>0x60</midino>  <!-- Note 96 = 0x60 in hex -->
            </control>

            <!-- Channel 2 Play Indicator - Maps to [Channel2],play_indicator Mixxx Control -->
            <control id="[Channel2],play_indicator">
                <group>[Channel2]</group>
                <key>play_indicator</key>
                <status>0x91</status>
                <midino>0x61</midino>  <!-- Note 97 = 0x61 in hex -->
            </control>

            <!-- ==================== AUTO DJ CONTROLS - BUILT-IN MIXXX CONTROLS ==================== -->
            
            <!-- AutoDJ fade_now trigger - Built-in Mixxx control for transition triggering -->
            <control id="[AutoDJ],fade_now">
                <group>[AutoDJ]</group>
                <key>fade_now</key>
                <status>0x91</status>
                <midino>0x5F</midino>  <!-- Note 95 = 0x5F in hex -->
            </control>

            <!-- AutoDJ shuffle_playlist - Optional randomization control -->
            <control id="[AutoDJ],shuffle_playlist">
                <group>[AutoDJ]</group>
                <key>shuffle_playlist</key>
                <status>0x91</status>
                <midino>0x62</midino>  <!-- Note 98 = 0x62 in hex -->
            </control>

            <!-- ==================== CROSSFADER TRACK SWITCH - AUTO DJ CONTROL ==================== -->
            
            <!-- Crossfader Track Switch - Triggers AutoDJ track switching via script function -->
            <control id="CrossfaderTrackSwitch">
                <group>[App]</group>
                <key>CrossfaderTrackSwitch</key>
                <status>0xB0</status>
                <midino>0x02</midino>  <!-- CC 2 = 0x02 in hex -->
                <options>
                    <Script-Binding/>
                </options>
            </control>

            <!-- ==================== BPM TRACKING VIA MIDI CC ==================== -->
            
            <!-- BPM tracking - Maps to [App],file_bpm for BPM detection -->
            <control id="[App],file_bpm">
                <group>[App]</group>
                <key>file_bpm</key>
                <status>0xB0</status>
                <midino>0x7B</midino>  <!-- CC 123 = 0x7B in hex -->
            </control>

            <!-- ==================== UV CONTROL FOR DYNAMIC EQ PARAMETERS ==================== -->
            
            <!-- UV Control - Maps to [UV_Control],bass_boost_max for dynamic EQ control -->
            <control id="[UV_Control],bass_boost_max">
                <group>[UV_Control]</group>
                <key>bass_boost_max</key>
                <status>0xB0</status>
                <midino>0x7C</midino>  <!-- CC 124 = 0x7C in hex -->
            </control>

            <!-- ==================== EFFECT PARAMETERS - ISSUE #4 FIX =================-->
            
            <!-- Effect Unit 1 - Channel 1 Bass EQ Control -->
            <control id="[EffectRack1_EffectUnit1_Effect1],parameter1">
                <group>[EffectRack1_EffectUnit1_Effect1]</group>
                <key>parameter1</key>
                <status>0x91</status>
                <midino>0x58</midino>  <!-- Note 88 = 0x58 in hex -->
            </control>

            <!-- Effect Unit 2 - Channel 1 Reverb Control -->
            <control id="[EffectRack1_EffectUnit2_Effect2],parameter1">
                <group>[EffectRack1_EffectUnit2_Effect2]</group>
                <key>parameter1</key>
                <status>0x91</status>
                <midino>0x59</midino>  <!-- Note 89 = 0x59 in hex -->
            </control>

            <!-- Add these Quick Effect mappings for echo functionality -->
            <control id="[EffectRack1_EffectUnit1_QuickEffect],drywet">
                <group>[EffectRack1_EffectUnit1_QuickEffect]</group>
                <key>drywet</key>
                <status>0xB0</status>
                <midino>0x7A</midino>  <!-- CC 122 -->
            </control>

            <control id="[EffectRack1_EffectUnit1_QuickEffect],parameter2">
                <group>[EffectRack1_EffectUnit1_QuickEffect]</group>
                <key>parameter2</key>
                <status>0xB0</status>
                <midino>0x7B</midino>  <!-- CC 123 -->
            </control>

            <control id="[EffectRack1_EffectUnit1_QuickEffect],parameter3">
                <group>[EffectRack1_EffectUnit1_QuickEffect]</group>
                <key>parameter3</key>
                <status>0xB0</status>
                <midino>0x7C</midino>  <!-- CC 124 -->
            </control>

            <!-- ==================== EQ PARAMETER CONTROLS - MIXXX NATIVE NAMES =================-->
            
            <!-- Channel 1 Bass EQ Parameter - Maps to [Channel1],effect1_bass -->
            <control id="[Channel1],effect1_bass">
                <group>[Channel1]</group>
                <key>effect1_bass</key>
                <status>0xB0</status>
                <midino>0x7D</midino>  <!-- CC 125 = 0x7D in hex -->
            </control>

            <!-- Channel 1 Mid EQ Parameter - Maps to [Channel1],effect1_mid -->
            <control id="[Channel1],effect1_mid">
                <group>[Channel1]</group>
                <key>effect1_mid</key>
                <status>0xB0</status>
                <midino>0x7E</midino>  <!-- CC 126 = 0x7E in hex -->
            </control>

            <!-- Channel 1 High EQ Parameter - Maps to [Channel1],effect1_high -->
            <control id="[Channel1],effect1_high">
                <group>[Channel1]</group>
                <key>effect1_high</key>
                <status>0xB0</status>
                <midino>0x7F</midino>  <!-- CC 127 = 0x7F in hex -->
            </control>

            <!-- Channel 2 Bass EQ Parameter - Maps to [Channel2],effect1_bass -->
            <control id="[Channel2],effect1_bass">
                <group>[Channel2]</group>
                <key>effect1_bass</key>
                <status>0xB0</status>
                <midino>0x80</midino>  <!-- CC 128 = 0x80 in hex -->
            </control>

            <!-- Channel 2 Mid EQ Parameter - Maps to [Channel2],effect1_mid -->
            <control id="[Channel2],effect1_mid">
                <group>[Channel2]</group>
                <key>effect1_mid</key>
                <status>0xB0</status>
                <midino>0x81</midino>  <!-- CC 129 = 0x81 in hex -->
            </control>

            <!-- Channel 2 High EQ Parameter - Maps to [Channel2],effect1_high -->
            <control id="[Channel2],effect1_high">
                <group>[Channel2]</group>
                <key>effect1_high</key>
                <status>0xB0</status>
                <midino>0x82</midino>  <!-- CC 130 = 0x82 in hex -->
            </control>

            <!-- ==================== DEBUG/TEST CONTROLS ==================== -->
            
            <!-- Debug toggle - Can be mapped to a test button for troubleshooting -->
            <control id="[Controls],debug_toggle">
                <group>[Controls]</group>
                <key>debug_toggle</key>
                <status>0x92</status>
                <midino>0x54</midino>  <!-- Note 84 = 0x54 in hex -->
            </control>

        </controls>
    </controller>
</MixxxControllerPreset>
